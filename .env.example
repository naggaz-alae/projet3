# Copie ce fichier en .env (jamais commité)
DATA_DIR=data

# --- Mistral (https://console.mistral.ai) ---
MISTRAL_API_KEY=
MODELE_CHAT=mistral-small-latest
MODELE_EMBEDDING=mistral-embed
DIMENSION_EMBEDDING=1024
# Prix par million de tokens : À VÉRIFIER sur la page tarifs de Mistral
PRIX_ENTREE_PAR_MILLION=0.1
PRIX_SORTIE_PAR_MILLION=0.3

# --- Base de données (localhost hors Docker, "db" dans docker compose) ---
DATABASE_URL=postgresql://rag:rag_password@localhost:5432/assurance

# --- Réglages RAG ---
TOP_K=5
# Similarité minimale pour appeler le LLM (0 = désactivé ; à calibrer avec l'évaluation)
SEUIL_SIMILARITE=0

# --- Interface Streamlit ---
API_URL=http://localhost:8000
